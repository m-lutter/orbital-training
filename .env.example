# Copy this file to .env.local and replace the placeholders.
# The publishable key is intended for browser use.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only local-development values. `.env.local` is ignored by git. Never
# prefix these with PUBLIC_, expose them to browser code, or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FITNESS_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
GOOGLE_HEALTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_HEALTH_CLIENT_SECRET=your-google-oauth-client-secret

