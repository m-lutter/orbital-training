# The project URL and publishable key are safe client configuration. Never put a
# service-role key or a Health provider credential in this application.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Production: https://orbital-training.com
# A physical device cannot reach your computer through localhost. For local
# testing, use an HTTPS tunnel or your computer's LAN URL if the Worker accepts it.
EXPO_PUBLIC_APP_ORIGIN=https://orbital-training.com

# Replace these before creating signed builds.
IOS_BUNDLE_IDENTIFIER=com.example.orbital.healthsync
ANDROID_PACKAGE=com.example.orbital.healthsync
